{
  "name": "knowpath",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "知径 KnowPath - AI 知识主线学习工具（Win / Ubuntu / Android 通吃）",
  "author": "KnowPath",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "serve": "node scripts/serve.cjs",
    "web": "npm run build && node scripts/serve.cjs",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "electron:dev": "electron .",
    "dist:win": "npm run icons && npm run build && electron-builder --win --x64",
    "dist:win:installer": "npm run icons && npm run build && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "@xyflow/react": "^12.3.5",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "dexie": "^4.0.10",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jszip": "^3.10.2",
    "lucide-react": "^0.453.0",
    "nanoid": "^5.0.7",
    "pdfjs-dist": "^4.10.38",
    "postcss": "^8.4.47",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "zustand": "^4.5.5"
  },
  "build": {
    "appId": "com.knowpath.desktop",
    "productName": "KnowPath",
    "copyright": "Copyright © 2026 KnowPath",
    "asar": true,
    "asarUnpack": [
      "build/icon.ico"
    ],
    "compression": "normal",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "KnowPath-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "知径 KnowPath",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
